# Copy to .env and fill in. Only PAPERLESS_URL and PAPERLESS_TOKEN are required.

# --- Paperless-ngx -----------------------------------------------------------
# URL the app uses to reach Paperless's API.
PAPERLESS_URL=http://paperless.local:8000
# URL your browser uses to open documents, if different (e.g. a reverse-proxy hostname).
#PAPERLESS_LINK_URL=https://paperless.example.com
# API token of a *read-only* Paperless user (see README, "Paperless setup").
PAPERLESS_TOKEN=
# ...or read the token from a file instead (e.g. a Docker secret):
#PAPERLESS_TOKEN_FILE=/run/secrets/paperless_token

# --- Ollama ------------------------------------------------------------------
# With the bundled docker-compose Ollama, leave this as is.
OLLAMA_URL=http://ollama:11434
# A small instruct model is enough. 3B gives noticeably better answers than 1.5B on CPU.
OLLAMA_MODEL=qwen2.5:3b-instruct
# Only set this on CPU-limited VMs/containers: the number of cores Ollama may use.
# Ollama sizes threads from the *host's* cores, and oversubscribing can be ~50x slower.
#OLLAMA_THREADS=4
# How long Ollama keeps the model in memory after a question.
#OLLAMA_KEEP_ALIVE=24h
# Preload the model at start-up and whenever Ollama has unloaded it (true/false).
#OLLAMA_WARM=true

# --- Web app -----------------------------------------------------------------
# Port on the host (docker compose) or to listen on (pip / systemd install).
PORT=8000
# Optional login (HTTP Basic). Strongly recommended if anyone else can reach the app:
# it shows passages from your documents to whoever opens it.
#ASK_USERNAME=ask
#ASK_PASSWORD=change-me
# Example questions shown under the ask box, separated by "|". An emoji prefix is optional.
#ASK_SUGGESTIONS=🚗 When is my car registration due?|⚡ What was my electric bill in March?|Show me my tax documents
# Extra search synonyms, "word=related,words; other=word". Handy for provider names, so that
# "electric bill" finds documents from your utility.
#ASK_SYNONYMS=electric=acmepower; internet=fastnet,fibrewave

# --- Fact cards, "coming up" reminders and totals ----------------------------
# The model reads each document once in the background and saves its key facts (kind, category,
# vendor, total, due/expiry dates, ID numbers). Nothing it says is kept unless the document's own
# text contains it. Enables instant answers, "how much did I spend…" totals and better reminders.
#FACTS=on
# Only extract between these hours (local time), e.g. overnight when Ollama is shared. Empty = any
# time nobody has asked a question for 2 minutes.
#FACTS_HOURS=1-6
#FACTS_MAX_CHARS=4000
# Where fact cards are stored (Docker: /data; systemd: /var/lib/paperless-ask).
#DATA_DIR=./data
# "Coming up" window (days), alert/calendar-alarm days before each date, and tags meaning "already paid".
#REMINDER_DAYS=60
#ALERT_DAYS=14,3,1,0
#DONE_TAGS=paid

# --- Tuning (defaults shown) -------------------------------------------------
#REFRESH_SECONDS=300   # full re-read of the library at least this often
#CHECK_SECONDS=30      # how often to check Paperless for changes
#LLM_DOCS=3            # documents given to the model per question
#MAX_SOURCES=5         # source cards shown per answer
